{
  "name": "resful-blog-api-1",
  "version": "1.0.0",
  "description": "A RESTful Blog API with authentication, posts, and comments",
  "main": "src/server.js",
  "scripts": {
    "start": "node database/scripts/teardown.js && node database/scripts/create.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "db:setup": "node database/scripts/create.js",
    "db:seed": "node database/scripts/seed.js",
    "db:teardown": "node database/scripts/teardown.js"
  },
  "keywords": [
    "rest",
    "api",
    "blog",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  }
}
