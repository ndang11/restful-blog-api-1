# Environment variables for the Blog API

# Node Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=blogdb

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_SECRET_REFRESH=your_jwt_refresh_secret_key_here_make_it_different_from_above
JWT_EXPIRES_IN=30d

# Password Hashing
BCRYPT_SALT_ROUNDS=12